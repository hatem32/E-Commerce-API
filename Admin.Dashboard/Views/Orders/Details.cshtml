@using AdminDashboard.Helpers
@using E_Commerce.Application.Profiles
@using E_Commerce.Domain.Entities.Orders
@using Microsoft.Extensions.Options
@model Order
@inject IOptions<UrlSettings> UrlSettings
@{
    ViewData["Title"] = "Order Details";
}

<div class="page-heading">
    <h1>Order #@Model.Id.ToString().Substring(0, 8)</h1>
    <a class="btn btn-outline-secondary" asp-action="Index"><i class="fas fa-arrow-left me-1"></i> Back to Orders</a>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="table-card mb-3">
            <h5 class="mb-3"><i class="fas fa-box me-2 text-muted"></i>Items</h5>
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th></th>
                        <th>Product</th>
                        <th>Price</th>
                        <th>Qty</th>
                        <th class="text-end">Line Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                <img src="@item.Product.PictureUrl.ToFullImageUrl(UrlSettings.Value.BaseUrl)" class="product-thumb" alt="@item.Product.ProductName" onerror="this.onerror=null;this.src='/favicon.ico';this.classList.add('p-1');" />
                            </td>
                            <td>@item.Product.ProductName</td>
                            <td>@item.Price.ToString("C")</td>
                            <td>@item.Quantity</td>
                            <td class="text-end">@((item.Price * item.Quantity).ToString("C"))</td>
                        </tr>
                    }
                </tbody>
            </table>

            <hr />

            <div class="d-flex justify-content-end">
                <table class="table table-borderless table-sm mb-0" style="max-width: 280px;">
                    <tbody>
                        <tr>
                            <td class="text-muted">Subtotal</td>
                            <td class="text-end">@Model.SubTotal.ToString("C")</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Delivery (@Model.DeliveryMethod?.ShortName)</td>
                            <td class="text-end">@Model.DeliveryMethod?.Cost.ToString("C")</td>
                        </tr>
                        <tr class="fw-bold fs-5">
                            <td>Total</td>
                            <td class="text-end">@Model.GetTotal().ToString("C")</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="table-card">
            <h5 class="mb-3"><i class="fas fa-truck me-2 text-muted"></i>Shipping Address</h5>
            <p class="mb-1 fw-semibold">@Model.ShipToAddress.FirstName @Model.ShipToAddress.LastName</p>
            <p class="mb-0 text-muted">
                @Model.ShipToAddress.Street<br />
                @Model.ShipToAddress.City, @Model.ShipToAddress.Country
            </p>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="table-card mb-3">
            <h5 class="mb-3"><i class="fas fa-circle-info me-2 text-muted"></i>Order Info</h5>
            <table class="table table-sm table-borderless mb-0">
                <tbody>
                    <tr>
                        <td class="text-muted">Buyer</td>
                        <td>@Model.BuyerEmail</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Date</td>
                        <td>@Model.OrderDate.LocalDateTime.ToString("dd MMM yyyy, hh:mm tt")</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Payment Intent</td>
                        <td class="text-break small font-monospace">@Model.PaymentIntentId</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Delivery</td>
                        <td>@Model.DeliveryMethod?.ShortName (@Model.DeliveryMethod?.DeliveryTime)</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="table-card">
            <h5 class="mb-3"><i class="fas fa-flag me-2 text-muted"></i>Order Status</h5>
            <p><span class="status-badge status-@Model.Status.ToString().ToLower() fs-6">@Model.Status</span></p>

            <form asp-action="UpdateStatus" method="post" class="d-flex gap-2">
                <input type="hidden" name="id" value="@Model.Id" />
                <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<OrderStatus>()">
                </select>
                <button type="submit" class="btn btn-primary text-nowrap"><i class="fas fa-check"></i></button>
            </form>
        </div>
    </div>
</div>
