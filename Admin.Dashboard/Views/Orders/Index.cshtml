@model IEnumerable<E_Commerce.Domain.Entities.Orders.Order>
@{
    ViewData["Title"] = "Orders";
}

<div class="page-heading">
    <h1>Orders</h1>
</div>

<div class="table-card">
    @if (Model.Any())
    {
        <table class="table table-hover align-middle datatable">
            <thead>
                <tr>
                    <th>Order #</th>
                    <th>Buyer</th>
                    <th>Date</th>
                    <th>Items</th>
                    <th>Delivery</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td><span class="font-monospace small">#@order.Id.ToString().Substring(0, 8)</span></td>
                        <td>@order.BuyerEmail</td>
                        <td>@order.OrderDate.LocalDateTime.ToString("dd MMM yyyy, hh:mm tt")</td>
                        <td>@order.Items.Sum(i => i.Quantity)</td>
                        <td>@order.DeliveryMethod?.ShortName</td>
                        <td class="fw-semibold">@order.GetTotal().ToString("C")</td>
                        <td>
                            <span class="status-badge status-@order.Status.ToString().ToLower()">@order.Status</span>
                        </td>
                        <td>
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@order.Id"><i class="fas fa-eye"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty-state">
            <i class="fas fa-receipt"></i>
            <p class="mb-0">No orders yet.</p>
        </div>
    }
</div>
