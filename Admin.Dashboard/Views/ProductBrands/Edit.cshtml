@model AdminDashboard.Models.Products.UpdatedProductNameViewModel
@{
    ViewData["Title"] = "Edit Brand";
}

<div class="page-heading">
    <h1>Edit Brand</h1>
    <a class="btn btn-outline-secondary" asp-action="Index"><i class="fas fa-arrow-left me-1"></i> Back to Brands</a>
</div>

<div class="table-card" style="max-width: 480px;">
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary"><i class="fas fa-check me-1"></i> Save</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
