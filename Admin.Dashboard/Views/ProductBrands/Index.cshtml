@model IEnumerable<E_Commerce.Domain.Entities.Products.ProductBrand>
@{
    ViewData["Title"] = "Product Brands";
}

<div class="page-heading">
    <h1>Product Brands</h1>
</div>

@if (TempData["Error"] is not null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row g-3">
    <div class="col-lg-4">
        <div class="table-card">
            <h5 class="mb-3"><i class="fas fa-plus me-2 text-muted"></i>Add New Brand</h5>
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                <div class="mb-3">
                    <label class="form-label">Brand Name</label>
                    <input name="Name" class="form-control" placeholder="e.g. Nike" />
                </div>
                <button type="submit" class="btn btn-primary w-100"><i class="fas fa-check me-1"></i> Add Brand</button>
            </form>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="table-card">
            @if (Model.Any())
            {
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var brand in Model)
                        {
                            <tr>
                                <td>@brand.Name</td>
                                <td>
                                    <a class="btn btn-sm btn-outline-warning" asp-action="Edit" asp-route-id="@brand.Id"><i class="fas fa-pen"></i></a>
                                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@brand.Id" onclick="return confirm('Delete this brand?');"><i class="fas fa-trash"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-copyright"></i>
                    <p class="mb-0">No brands yet.</p>
                </div>
            }
        </div>
    </div>
</div>
