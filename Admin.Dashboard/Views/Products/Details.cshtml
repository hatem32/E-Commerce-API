@using AdminDashboard.Helpers
@using E_Commerce.Application.Profiles
@using Microsoft.Extensions.Options
@model E_Commerce.Domain.Entities.Products.Product
@inject IOptions<UrlSettings> UrlSettings
@{
    ViewData["Title"] = "Product Details";
}

<div class="page-heading">
    <h1>Product Details</h1>
    <a class="btn btn-outline-secondary" asp-action="Index"><i class="fas fa-arrow-left me-1"></i> Back to Products</a>
</div>

<div class="table-card">
    <div class="row g-4">
        <div class="col-md-5">
            <img src="@Model.PictureUrl.ToFullImageUrl(UrlSettings.Value.BaseUrl)"
                 alt="@Model.Name"
                 class="w-100 rounded-3 border"
                 style="max-height: 380px; object-fit: contain; background: #fafafa;"
                 onerror="this.onerror=null;this.src='/favicon.ico';this.classList.add('p-5');" />
        </div>

        <div class="col-md-7">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h2 class="mb-1">@Model.Name</h2>
                    <div class="mb-3">
                        <span class="badge-soft me-1">@Model.ProductBrand?.Name</span>
                        <span class="badge-soft">@Model.ProductType?.Name</span>
                    </div>
                </div>
                <div class="fs-3 fw-bold text-primary">@Model.Price.ToString("C")</div>
            </div>

            <hr />

            <h6 class="text-muted text-uppercase small">Description</h6>
            <p>@Model.Description</p>

            <h6 class="text-muted text-uppercase small mt-4">Details</h6>
            <table class="table table-sm table-borderless mb-0">
                <tbody>
                    <tr>
                        <td class="text-muted" style="width: 160px;">Product ID</td>
                        <td>#@Model.Id</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Brand</td>
                        <td>@Model.ProductBrand?.Name</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Type</td>
                        <td>@Model.ProductType?.Name</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Price</td>
                        <td>@Model.Price.ToString("C")</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Image Path</td>
                        <td class="text-break">@Model.PictureUrl</td>
                    </tr>
                </tbody>
            </table>

            <div class="mt-4">
                <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id"><i class="fas fa-pen me-1"></i> Edit</a>
                <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.Id"><i class="fas fa-trash me-1"></i> Delete</a>
            </div>
        </div>
    </div>
</div>
