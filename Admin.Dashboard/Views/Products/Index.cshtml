@using AdminDashboard.Helpers
@using E_Commerce.Application.Profiles
@using Microsoft.Extensions.Options
@model IEnumerable<E_Commerce.Domain.Entities.Products.Product>
@inject IOptions<UrlSettings> UrlSettings
@{
    ViewData["Title"] = "Products";
}

<div class="page-heading">
    <h1>Products</h1>
    <a class="btn btn-primary" asp-action="Create"><i class="fas fa-plus me-1"></i> Add Product</a>
</div>

<div class="table-card">
    @if (Model.Any())
    {
        <table class="table table-hover align-middle datatable">
            <thead>
                <tr>
                    <th></th>
                    <th>Name</th>
                    <th>Brand</th>
                    <th>Type</th>
                    <th>Price</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model)
                {
                    <tr>
                        <td>
                            <img src="@product.PictureUrl.ToFullImageUrl(UrlSettings.Value.BaseUrl)" class="product-thumb" alt="@product.Name" onerror="this.onerror=null;this.src='/favicon.ico';this.classList.add('p-1');" />
                        </td>
                        <td>
                            <a class="fw-semibold text-decoration-none" asp-action="Details" asp-route-id="@product.Id">@product.Name</a>
                            <div class="text-muted small">@(product.Description.Length > 60 ? product.Description.Substring(0, 60) + "…" : product.Description)</div>
                        </td>
                        <td><span class="badge-soft">@product.ProductBrand?.Name</span></td>
                        <td>@product.ProductType?.Name</td>
                        <td>@product.Price.ToString("C")</td>
                        <td>
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@product.Id"><i class="fas fa-eye"></i></a>
                            <a class="btn btn-sm btn-outline-warning" asp-action="Edit" asp-route-id="@product.Id"><i class="fas fa-pen"></i></a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@product.Id"><i class="fas fa-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty-state">
            <i class="fas fa-box-open"></i>
            <p>No products yet.</p>
            <a class="btn btn-primary" asp-action="Create"><i class="fas fa-plus me-1"></i> Add your first product</a>
        </div>
    }
</div>
