@using AdminDashboard.Helpers
@using E_Commerce.Application.Profiles
@using Microsoft.Extensions.Options
@model E_Commerce.Domain.Entities.Products.Product
@inject IOptions<UrlSettings> UrlSettings
@{
    ViewData["Title"] = "Delete Product";
}

<div class="page-heading">
    <h1>Delete Product</h1>
    <a class="btn btn-outline-secondary" asp-action="Index"><i class="fas fa-arrow-left me-1"></i> Back to Products</a>
</div>

<div class="table-card" style="max-width: 640px;">
    <div class="alert alert-danger">
        <i class="fas fa-triangle-exclamation me-1"></i>
        Are you sure you want to delete this product? This action can't be undone.
    </div>

    <div class="d-flex align-items-center gap-3 mb-4">
        <img src="@Model.PictureUrl.ToFullImageUrl(UrlSettings.Value.BaseUrl)" class="product-thumb" style="width:64px;height:64px;" alt="@Model.Name" onerror="this.onerror=null;this.src='/favicon.ico';" />
        <div>
            <div class="fw-semibold fs-5">@Model.Name</div>
            <div class="text-muted">@Model.ProductBrand?.Name &middot; @Model.ProductType?.Name &middot; @Model.Price.ToString("C")</div>
        </div>
    </div>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger"><i class="fas fa-trash me-1"></i> Yes, Delete</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>
