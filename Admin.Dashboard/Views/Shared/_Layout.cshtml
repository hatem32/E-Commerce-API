<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - E-Commerce Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Admin_Dashboard.styles.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/simple-datatables@latest/dist/style.css" rel="stylesheet" />
    <link href="~/css/styles.css" rel="stylesheet" />
    <link href="~/css/admin-theme.css" rel="stylesheet" asp-append-version="true" />
    <script src="https://use.fontawesome.com/releases/v6.1.0/js/all.js" crossorigin="anonymous"></script>
</head>
<body>

    @{
        string CurrentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
        Func<string, string> IsActive = (controllers) =>
            controllers.Split(',').Contains(CurrentController) ? "active" : "";
    }

    <nav class="sb-topnav navbar navbar-expand navbar-dark">
        <!-- Navbar Brand-->
        <a class="navbar-brand ps-3" asp-controller="Home" asp-action="Index">
            <i class="fas fa-bag-shopping"></i>E-Commerce Admin
        </a>
        <!-- Sidebar Toggle-->
        <button class="btn btn-link btn-sm order-1 order-lg-0 me-4 me-lg-0 text-white" id="sidebarToggle" href="#!"><i class="fas fa-bars"></i></button>
        <!-- Navbar Search-->
        <form class="d-none d-md-inline-block form-inline ms-auto me-0 me-md-3 my-2 my-md-0">
            <!-- Navbar-->
            <ul class="navbar-nav ms-auto ms-md-0 me-3 me-lg-4">
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" id="navbarDropdown" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="fas fa-user fa-fw"></i></a>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
                        <li><a class="dropdown-item" href="#!">Settings</a></li>
                        <li><a class="dropdown-item" href="#!">Activity Log</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Logout"><i class="fas fa-right-from-bracket me-1"></i>Logout</a></li>
                    </ul>
                </li>
            </ul>
        </form>

    </nav>


    <div id="layoutSidenav">
        <div id="layoutSidenav_nav">
            <nav class="sb-sidenav accordion sb-sidenav-dark" id="sidenavAccordion">
                <div class="sb-sidenav-menu">
                    <div class="nav">
                        <div class="sb-sidenav-menu-heading">Overview</div>

                        <a class="nav-link @IsActive("Home")" asp-controller="Home" asp-action="Index">
                            <div class="sb-nav-link-icon"><i class="fas fa-gauge-high"></i></div>
                            Dashboard
                        </a>

                        <div class="sb-sidenav-menu-heading">Security</div>

                        <a class="nav-link @IsActive("Roles")" asp-controller="Roles" asp-action="Index">
                            <div class="sb-nav-link-icon"><i class="fas fa-user-shield"></i></div>
                            Roles
                        </a>
                        <a class="nav-link @IsActive("Users")" asp-controller="Users" asp-action="Index">
                            <div class="sb-nav-link-icon"><i class="fas fa-users"></i></div>
                            Users
                        </a>
                    </div>
                    <div class="nav">
                        <div class="sb-sidenav-menu-heading">Catalog</div>

                        <a class="nav-link @IsActive("Products")" asp-controller="Products" asp-action="Index">
                            <div class="sb-nav-link-icon"><i class="fas fa-box-open"></i></div>
                            Products
                        </a>
                        <a class="nav-link @IsActive("ProductTypes")" asp-controller="ProductTypes" asp-action="Index">
                            <div class="sb-nav-link-icon"><i class="fas fa-tags"></i></div>
                            Product Types
                        </a>
                        <a class="nav-link @IsActive("ProductBrands")" asp-controller="ProductBrands" asp-action="Index">
                            <div class="sb-nav-link-icon"><i class="fas fa-copyright"></i></div>
                            Product Brands
                        </a>

                    </div>
                    <div class="nav">
                        <div class="sb-sidenav-menu-heading">Sales</div>

                        <a class="nav-link @IsActive("Orders")" asp-controller="Orders" asp-action="Index">
                            <div class="sb-nav-link-icon"><i class="fas fa-receipt"></i></div>
                            Orders
                        </a>
                    </div>
                </div>
                <div class="sb-sidenav-footer">
                    <div class="small">Logged in as:</div>
                    Admin
                </div>
            </nav>
        </div>

        <div id="layoutSidenav_content">
            <div class="container-fluid px-4">
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>

            <footer class="py-4 bg-light mt-auto">
                <div class="container-fluid px-4">
                    <div class="d-flex align-items-center justify-content-between small">
                        <div class="text-muted">Copyright &copy; @DateTime.Now.Year - E-Commerce Admin</div>
                        <div>
                            <a href="#">Privacy Policy</a>
                            &middot;
                            <a href="#">Terms &amp; Conditions</a>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/simple-datatables@latest" type="text/javascript"></script>
    <script src="~/js/scripts.js"></script>
    <script>
            document.querySelectorAll("table.datatable").forEach(function(table) {
                new simpleDatatables.DataTable(table);
            });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
