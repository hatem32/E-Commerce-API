@using AdminDashboard.Helpers
@using E_Commerce.Application.Profiles
@using Microsoft.Extensions.Options
@model AdminDashboard.Models.DashboardViewModel
@inject IOptions<UrlSettings> UrlSettings
@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-heading">
    <h1>Dashboard</h1>
    <div class="text-muted">Welcome back, here's what's happening in your store today.</div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6 col-xl-3">
        <div class="stat-card bg-users">
            <i class="fas fa-users stat-icon"></i>
            <div class="stat-value">@Model.UsersCount</div>
            <div class="stat-label">Users</div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="stat-card bg-products">
            <i class="fas fa-box-open stat-icon"></i>
            <div class="stat-value">@Model.ProductsCount</div>
            <div class="stat-label">Products</div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="stat-card bg-brands">
            <i class="fas fa-copyright stat-icon"></i>
            <div class="stat-value">@Model.ProductBrandsCount</div>
            <div class="stat-label">Brands</div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="stat-card bg-types">
            <i class="fas fa-tags stat-icon"></i>
            <div class="stat-value">@Model.ProductTypesCount</div>
            <div class="stat-label">Product Types</div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="table-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0"><i class="fas fa-clock-rotate-left me-2 text-muted"></i>Recently Added Products</h5>
                <a class="btn btn-sm btn-primary" asp-controller="Products" asp-action="Index">View All</a>
            </div>

            @if (Model.RecentProducts.Any())
            {
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Name</th>
                            <th>Brand</th>
                            <th>Type</th>
                            <th>Price</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in Model.RecentProducts)
                        {
                            <tr>
                                <td>
                                    <img src="@product.PictureUrl.ToFullImageUrl(UrlSettings.Value.BaseUrl)" class="product-thumb" alt="@product.Name" onerror="this.onerror=null;this.src='/favicon.ico';this.classList.add('p-1');" />
                                </td>
                                <td>@product.Name</td>
                                <td><span class="badge-soft">@product.ProductBrand?.Name</span></td>
                                <td>@product.ProductType?.Name</td>
                                <td>@product.Price.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-box-open"></i>
                    <p class="mb-0">No products yet. Start by adding your first product.</p>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-4">
        <div class="table-card h-100">
            <h5 class="mb-3"><i class="fas fa-bolt me-2 text-muted"></i>Quick Actions</h5>
            <div class="d-grid gap-2">
                <a class="btn btn-primary" asp-controller="Products" asp-action="Create"><i class="fas fa-plus me-1"></i> Add Product</a>
                <a class="btn btn-outline-secondary" asp-controller="ProductBrands" asp-action="Index"><i class="fas fa-copyright me-1"></i> Manage Brands</a>
                <a class="btn btn-outline-secondary" asp-controller="ProductTypes" asp-action="Index"><i class="fas fa-tags me-1"></i> Manage Product Types</a>
                <a class="btn btn-outline-secondary" asp-controller="Users" asp-action="Index"><i class="fas fa-users me-1"></i> Manage Users</a>
                <a class="btn btn-outline-secondary" asp-controller="Orders" asp-action="Index"><i class="fas fa-receipt me-1"></i> View Orders</a>
            </div>

            <hr class="my-3" />

            <h6 class="text-muted">Orders placed</h6>
            <a class="stat-card bg-orders mt-2 d-block text-decoration-none" asp-controller="Orders" asp-action="Index">
                <i class="fas fa-receipt stat-icon"></i>
                <div class="stat-value">@Model.OrdersCount</div>
                <div class="stat-label">Total Orders</div>
            </a>
        </div>
    </div>
</div>
